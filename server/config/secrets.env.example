# =============================================================================
# Unified Environment Configuration (Local Bare-Metal & Docker Compose)
# =============================================================================
# Place this file at `server/config/secrets.env` (and delete `docker/.env`).
# Never use these default demo credentials in production.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=demo
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
# Used when running Python services directly on your machine (Docker overrides internally)
DATABASE_URL=postgresql+psycopg://demo:demo@localhost:5433/demo

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
NEO4J_URL=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=demo
NEO4J_PASSWORD=demo
NEO4J_DATABASE=demo

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=demo

# -----------------------------------------------------------------------------
# S3 / SeaweedFS Storage
# -----------------------------------------------------------------------------
S3_URL=http://localhost:8333
S3_PORT=8333
S3_USERNAME=demo
S3_PASSWORD=demo
STORAGE_PATH=/tmp/demo-document-staging/docs

# -----------------------------------------------------------------------------
# Temporal Workflow Orchestration
# -----------------------------------------------------------------------------
TEMPORAL_ENABLED=true
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_MICROSERVICES_Tdemo_QUEUE=demo-microservices

# -----------------------------------------------------------------------------
# Application & Service Ports (Host Mappings)
# -----------------------------------------------------------------------------
CHAT_SERVICE_PORT=8001
RAG_SERVICE_PORT=8002
AUTH_SERVICE_PORT=8003
MD_MAKER_PORT=8005
MD_INGESTOR_PORT=8006
SERVER_PORT=8080
CLIENT_PORT=5173

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=ask-local-demo-jwt-secret-change-before-deployment
SECRET=ask-local-demo-microservices-secret

# -----------------------------------------------------------------------------
# Guardrails & MCP
# -----------------------------------------------------------------------------
NEMO_GUARDRAILS_ENABLED=false
NEMO_GUARDRAILS_CONFIG=/demo/server/config/guardrails
MCP_SERVERS_JSON=[]

# -----------------------------------------------------------------------------
# LLM Providers & External Integrations
# -----------------------------------------------------------------------------
# Local host Ollama URL vs. Docker bridge Ollama URL
OLLAMA_BASE_URL=http://localhost:11434
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

OPENAI_API_KEY=

AZURE_ENDPOINT=
AZURE_DEPLOYMENT_NAME=
AZURE_CHAT_API_VERSION=
AZURE_CHAT_API_KEY=
AZURE_EMBEDDING_API_VERSION=
AZURE_EMBEDDING_API_KEY=

GOOGLE_PROJECT_ID=
GOOGLE_REGION_LLM=
GOOGLE_REGION_EMBEDDER=

OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

HUGGINGFACE_API_TOKEN=

SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Observability (Optional `--profile observability`)
# -----------------------------------------------------------------------------
OTEL_ENABLED=True
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=demo
GRAFANA_ADMIN_PASSWORD=demo